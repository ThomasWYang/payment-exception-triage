# Local demo configuration. All values are synthetic; no real credentials.
DATABASE_PATH=var/payment_triage.db
POLICY_PATH=sample-data/policies.json
REFUND_CAP_CENTS=1000000
AUTO_RETRY_LIMIT_CENTS=100000
AUTO_APPROVE_ENABLED=true
DEGRADED_MODE=false
EXECUTOR_MODE=mock
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=65536
PLANNER_MAX_TOOL_CALLS=8
PLANNER_TIMEOUT_SECONDS=5
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Synthetic API keys (demo only)
API_KEY_AGENT=agent-key
API_KEY_ANALYST=analyst-key
API_KEY_APPROVER=approver-key
API_KEY_APPROVER_ALICE=approver-alice-key
